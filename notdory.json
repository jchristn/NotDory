{
  "nodeId": "notdory-1",
  "rest": {
    "hostname": "127.0.0.1",
    "port": 8700,
    "ssl": false
  },
  "database": {
    "type": "Sqlite",
    "filename": "data/notdory.db",
    "hostname": "127.0.0.1",
    "port": 0,
    "databaseName": "notdory",
    "logQueries": false,
    "requireEncryption": false
  },
  "recallDb": {
    "endpoint": "http://127.0.0.1:8600",
    "adminApiKey": "override-via-env"
  },
  "auth": {
    "issuer": "notdory",
    "sessionLifetimeMinutes": 1440,
    "seedAdminEmail": "admin@notdory.local",
    "seedAdminPassword": "override-via-env",
    "defaultAccessKey": "notdorydefaultkey",
    "defaultSecretKey": "override-via-env"
  },
  "logging": {
    "consoleLogging": true,
    "logQueries": false
  },
  "requestHistory": {
    "enabled": true,
    "captureHeaders": true,
    "captureBodies": true,
    "maxBodyBytes": 16384
  },
  "retention": {
    "enabled": true,
    "maxAgeDays": 30,
    "sweepIntervalMinutes": 60
  },
  "observability": {
    "enabled": true,
    "serviceName": "notdory-server",
    "prometheusEnabled": true,
    "prometheusHostname": "localhost",
    "prometheusPort": 9464,
    "prometheusPath": "/metrics",
    "tracingEnabled": true,
    "otlpEndpoint": "http://localhost:4317",
    "otlpProtocol": "grpc",
    "samplingRatio": 1,
    "includeRuntimeMetrics": true,
    "includeProcessMetrics": true
  }
}